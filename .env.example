# Configuration de l'application
SECRET_KEY=votre_cle_secrete_a_changer
DATABASE_URL=sqlite:///cabinet.db

# Configuration Google API (optionnel)
GOOGLE_CLIENT_ID=votre_client_id
GOOGLE_CLIENT_SECRET=votre_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback

# Agenda Google où créer les rendez-vous : l'adresse Gmail de votre agenda,
# partagé au préalable avec l'email du compte de service (client_email du JSON).
# Sans cette ligne, les événements partent dans l'agenda invisible du compte de service.
GOOGLE_CALENDAR_ID=votre_adresse@gmail.com

# Configuration Twilio pour SMS et WhatsApp
TWILIO_ACCOUNT_SID=votre_twilio_account_sid
TWILIO_AUTH_TOKEN=votre_twilio_auth_token
TWILIO_PHONE_NUMBER=+33123456789
TWILIO_WHATSAPP_NUMBER=whatsapp:+33123456789

# Configuration des rappels automatiques
ENABLE_REMINDERS=True
REMINDER_HOURS_BEFORE=24
REMINDER_METHOD=both

# Configuration email (optionnel pour notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe
